# 汉衣图鉴 · 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# 豆包 Vision API Key（选填，不填则使用本地 CLIP 模式）
VISION_API_KEY=your_doubao_api_key_here

# API 地址（默认已有，一般无需修改）
VISION_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 模型名称（默认已有，一般无需修改）
VISION_MODEL=doubao-seed-2-0-pro-260215

# Endpoint ID（默认已有，一般无需修改）
VISION_ENDPOINT_ID=ep-m-20260322005833-drhjw
